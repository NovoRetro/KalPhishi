{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalphishi",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-01",

  // public/ is generated by `npm run build` — see scripts/build-public.js
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kalphishi",
      "database_id": "4718ac0c-d6f3-4c3f-bf0f-43c123e0452b",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": {
    "crons": ["0 13,17,21 * * *"]
  },

  // surfaces per-invocation CPU time, which is how PBKDF2_ITERATIONS gets tuned
  "observability": { "enabled": true }
}
