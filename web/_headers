# Cache policy. Published to public/_headers by scripts/build-public.js.
#
# Two opposite rules, and the split is the whole point:
#
#   · index.html is the ONE file whose URL never changes, so it is the only thing that can
#     go stale in a way nothing recovers from. It carries the ?v= stamps that point at
#     every other file, so a stale copy pins a visitor to a stale bundle — the failure
#     reads as "the feature you shipped isn't there", which is indistinguishable from a bug
#     and is exactly the report a tester would send. no-cache does not mean "do not store";
#     it means "never reuse without asking", which is what a pointer file needs.
#
#   · /web/*.js are content-hashed by the build (?v=<sha256 prefix>), so a given URL's bytes
#     can never change. Revalidating them was pure waste — a round trip per script per page
#     load to be told nothing moved. immutable says not to bother, and the stamp is what
#     makes that safe: new content means a new URL, not a changed response.
#
# /data/*.json are deliberately absent. They are NOT hashed and do change in place on a
# data refresh, so they keep the default revalidate-every-time behaviour.

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/web/*
  Cache-Control: public, max-age=31536000, immutable

# /sw.js must never be served from cache. A stale worker is the one file that can pin a
# device to an old bundle with no network round trip at all to correct it — the browser
# would keep handing out a worker whose cache name never changes and whose activate step
# therefore never evicts anything. Browsers already special-case worker updates, but the
# cost of being explicit here is zero and the failure it prevents is unrecoverable
# without asking a tester to clear site data.
/sw.js
  Cache-Control: no-cache

# The manifest changes about as often as the app is renamed. A day is long enough to stop
# it being fetched on every load and short enough that a change lands the next day.
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Icons are NOT content-hashed, so they cannot take the /web/* immutable rule. A week is
# the compromise: effectively free on repeat visits, and a redesigned icon reaches
# everybody within a week rather than within a year.
/icons/*
  Cache-Control: public, max-age=604800
